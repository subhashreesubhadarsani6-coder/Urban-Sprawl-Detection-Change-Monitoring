# ==============================================================================
# UrbanScope AI - Environment Configuration Example
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Backend Configuration
PROJECT_NAME="UrbanScope AI Backend"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Connection (SQLite default, PostgreSQL supported)
DATABASE_URL="sqlite:///./backend/urbanscope.db"

# Storage Settings (limits and directories)
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB in bytes

# Satellite Ingestion API (Sentinel Hub / Copernicus Data Space Ecosystem)
SENTINEL_CLIENT_ID="your_client_id_here"
SENTINEL_CLIENT_SECRET="your_client_secret_here"
SENTINEL_TOKEN_URL="https://services.sentinel-hub.com/oauth/token"
